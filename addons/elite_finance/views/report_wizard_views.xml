<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Opened from the report viewer ("More filters"), each OCA wizard
         form shows an Apply button in place of its View / Export buttons:
         the dialog saves the filters and the viewer re-renders the report
         it already shows. Opened any other way, the form is untouched. -->

    <record id="general_ledger_wizard_viewer" model="ir.ui.view">
        <field name="name">general.ledger.report.wizard.viewer</field>
        <field name="model">general.ledger.report.wizard</field>
        <field name="inherit_id" ref="account_financial_report.general_ledger_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="inside">
                <button special="save" string="Apply" class="btn-primary"
                        invisible="not context.get('elite_finance_viewer')"/>
            </xpath>
            <xpath expr="//footer//button[@name='button_export_html']" position="attributes">
                <attribute name="invisible">context.get('elite_finance_viewer')</attribute>
            </xpath>
            <xpath expr="//footer//button[@name='button_export_pdf']" position="attributes">
                <attribute name="invisible">context.get('elite_finance_viewer')</attribute>
            </xpath>
            <xpath expr="//footer//button[@name='button_export_xlsx']" position="attributes">
                <attribute name="invisible">context.get('elite_finance_viewer')</attribute>
            </xpath>
        </field>
    </record>

