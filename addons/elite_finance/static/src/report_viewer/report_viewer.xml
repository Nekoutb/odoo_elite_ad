<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="elite_finance.ReportViewer">
        <div class="o_elite_report_viewer d-flex flex-column h-100 w-100">
            <div class="o_elite_report_bar d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom bg-view">
                <span class="fw-bold me-3" t-esc="title"/>
                <t t-foreach="state.fields" t-as="field" t-key="field.name">
                    <label class="small text-muted mb-0" t-att-for="'o_elite_filter_' + field.name" t-esc="field.label"/>
                    <input t-if="field.type == 'date'" type="date"
                           class="form-control form-control-sm w-auto"
                           t-att-id="'o_elite_filter_' + field.name"
                           t-att-name="field.name"
                           t-att-required="field.required"
                           t-att-value="state.filters[field.name] || ''"
                           t-on-change="(ev) => this.onFilterChange(field.name, ev.target.value)"/>
                    <select t-elif="field.type == 'selection'"
                            class="form-select form-select-sm w-auto"
                            t-att-id="'o_elite_filter_' + field.name"
                            t-att-name="field.name"
                            t-on-change="(ev) => this.onFilterChange(field.name, ev.target.value)">
                        <option t-foreach="field.options" t-as="option" t-key="option.value"
                                t-att-value="option.value"
                                t-att-selected="state.filters[field.name] == option.value"
                                t-esc="option.label"/>
                    </select>
                </t>
                <button class="btn btn-primary btn-sm o_elite_report_apply" t-on-click="apply"
                        t-att-disabled="state.busy">Apply</button>
                <button class="btn btn-secondary btn-sm o_elite_report_more" t-on-click="openFilters"
                        t-att-disabled="state.busy">More filters…</button>
                <span class="flex-grow-1"/>
                <button class="btn btn-secondary btn-sm o_elite_report_pdf" t-on-click="() => this.exportAs('pdf')"
                        t-att-disabled="state.busy"><i class="fa fa-file-pdf-o me-1" role="img"/>PDF</button>
                <button class="btn btn-secondary btn-sm o_elite_report_xlsx" t-on-click="() => this.exportAs('xlsx')"
                        t-att-disabled="state.busy"><i class="fa fa-file-excel-o me-1" role="img"/>Excel</button>
            </div>
            <iframe t-if="state.url" class="o_elite_report_frame flex-grow-1 w-100 border-0 bg-white"
                    style="min-height: 75vh;"
                    t-att-src="state.url" t-key="state.version" title="Report"/>
        </div>
    </t>

</templates>
