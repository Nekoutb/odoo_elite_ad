<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    One screen, not a menu of queues. The rows a user sees are already
    narrowed to the kinds their groups let them act on, so Finance and the
    Operations Manager open the same menu and find different work.
  -->

  <record id="view_clearance_task_list" model="ir.ui.view">
    <field name="name">clearance.task.list</field>
    <field name="model">clearance.task</field>
    <field name="arch" type="xml">
      <list string="My Tasks" create="false" delete="false"
            default_order="date_deadline asc"
            decoration-warning="kind in ['doc_waiver', 'advance_waiver']"
            decoration-info="kind in ['recharge_ops', 'recharge_gm']">
        <field name="kind" string="Action needed"/>
        <field name="name" string="Reference"/>
        <field name="partner_id"/>
        <field name="detail"/>
        <field name="amount" sum="Total"/>
        <field name="date_deadline"/>
        <field name="file_id" optional="hide"/>
        <field name="res_model" column_invisible="1"/>
        <field name="currency_id" column_invisible="1"/>
        <field name="company_id" column_invisible="1"
               groups="base.group_multi_company"/>
        <button name="action_open" type="object" string="Open"
                class="btn-primary" icon="fa-arrow-circle-right"/>
      </list>
    </field>
  </record>

  <record id="view_clearance_task_search" model="ir.ui.view">
    <field name="name">clearance.task.search</field>
    <field name="model">clearance.task</field>
    <field name="arch" type="xml">
      <search string="My Tasks">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="file_id"/>
        <filter name="expenses" string="Expenses"
                domain="[('res_model', '=', 'logistics.expense')]"/>
        <filter name="files" string="Files"
                domain="[('res_model', '=', 'logistics.file')]"/>
        <separator/>
        <filter name="waiting_a_week" string="Waiting over a week"
                domain="[('date_deadline', '&lt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
        <group>
          <filter name="by_kind" string="Action needed"
                  context="{'group_by': 'kind'}"/>
          <filter name="by_client" string="Client"
                  context="{'group_by': 'partner_id'}"/>
          <filter name="by_file" string="File"
                  context="{'group_by': 'file_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_clearance_tasks" model="ir.actions.act_window">
    <field name="name">My Tasks</field>
    <field name="res_model">clearance.task</field>
    <field name="view_mode">list</field>
    <field name="context">{'search_default_by_kind': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Nothing is waiting on you</p>
      <p>This list shows only the work your role can act on. When a file or
      an expense reaches a checkpoint that is yours, it appears here.</p>
    </field>
  </record>

  <menuitem id="menu_clearance_tasks" name="My Tasks"
            parent="menu_clearance_root"
            action="action_clearance_tasks"
            sequence="5" groups="group_clearance_user"/>

</odoo>
