<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="logistics_service_type_view_form" model="ir.ui.view">
        <field name="name">logistics.service.type.form</field>
        <field name="model">logistics.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Service Type"/>
                        <h1><field name="name" placeholder="e.g. Import clearance — sea freight"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. IMP-SEA"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="commission_rate"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Required Documents" name="documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type_id"/>
                                    <field name="is_mandatory"/>
                                    <field name="note" placeholder="Optional guidance for the ops team"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What this service covers."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="logistics_service_type_view_list" model="ir.ui.view">
        <field name="name">logistics.service.type.list</field>
        <field name="model">logistics.service.type</field>
        <field name="arch" type="xml">
            <list string="Service Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="document_count" string="Documents"/>
                <field name="commission_rate"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_logistics_service_type" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">logistics.service.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a service type and the documents it requires</p>
            <p>Every file opened under this service type inherits this checklist.</p>
        </field>
    </record>

</odoo>
