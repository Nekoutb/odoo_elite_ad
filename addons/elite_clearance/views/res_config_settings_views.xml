<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="clearance_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.clearance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Clearance" name="elite_clearance">
                    <block title="Accounting">
                        <setting string="Out-of-Pocket Expenses Account"
                                 help="Balance-sheet account holding recoverable client disbursements until the invoice clears them.">
                            <field name="clearance_oop_account_id"/>
                        </setting>
                        <setting string="Employee Advances Account"
                                 help="Where cash advances sit until justified with supporting documents.">
                            <field name="clearance_advance_account_id"/>
                        </setting>
                        <setting string="Clearance Fee Income Account"
                                 help="Income account for the commission and the customs service fee.">
                            <field name="clearance_fee_account_id"/>
                        </setting>
                        <setting string="Miscellaneous Journal"
                                 help="Used for advance justification entries.">
                            <field name="clearance_misc_journal_id"/>
                        </setting>
                        <setting string="Sales Journal"
                                 help="Journal the client clearance invoice is raised in. Empty = the company's first sales journal.">
                            <field name="clearance_sale_journal_id"/>
                        </setting>
                    </block>
                    <block title="Approvals">
                        <setting string="Waiver Approvers"
                                 help="Who may approve starting work with incomplete documentation. Empty = any Clearance Manager.">
                            <field name="clearance_waiver_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Expense Approvers"
                                 help="Who may approve expenses before disbursement. Empty = any Clearance Manager.">
                            <field name="clearance_expense_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Disbursement (Finance) Approvers"
                                 help="Who may settle disbursements and justify advances. Empty = any Clearance Finance user.">
                            <field name="clearance_finance_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Billing Approvers"
                                 help="Who may raise client invoices and mark files complete. Empty = any Clearance Finance user.">
                            <field name="clearance_billing_approver_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_clearance_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'elite_clearance'}</field>
    </record>

</odoo>
