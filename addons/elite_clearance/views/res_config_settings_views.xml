<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="clearance_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.clearance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Clearance" name="elite_clearance">
                    <block title="Accounting">
                        <setting string="Out-of-Pocket Expenses Account"
                                 help="Balance-sheet account holding recoverable client disbursements until the invoice clears them.">
                            <field name="clearance_oop_account_id"/>
                        </setting>
                        <setting string="Employee Advances Account"
                                 help="Where cash advances sit until justified with supporting documents.">
                            <field name="clearance_advance_account_id"/>
                        </setting>
                        <setting string="Fee Income Account (default)"
                                 help="Fallback for fee lines, used only where the two accounts below are left empty.">
                            <field name="clearance_fee_account_id"/>
                        </setting>
                        <setting string="Disbursement Undercharge Account"
                                 help="Expense account for what was disbursed for the client but deliberately not recharged. 47xx still clears in full; the shortfall is booked here as a cost.">
                            <field name="clearance_oop_undercharge_account_id"/>
                        </setting>
                        <setting string="Disbursement Overcharge Account"
                                 help="Income account for anything charged above what was actually disbursed, kept apart from the commission and the service fee.">
                            <field name="clearance_oop_overcharge_account_id"/>
                        </setting>
                        <setting string="Commission Income Account (706x)"
                                 help="Where the clearance commission is credited — the percentage of the out-of-pocket total set on the service type. A subdivision of 706.">
                            <field name="clearance_commission_account_id"/>
                        </setting>
                        <setting string="Service Fee Income Account (706x)"
                                 help="Where the customs service fee keyed from the declaration is credited. Also a subdivision of 706, kept apart from the commission so the two revenue streams are reportable.">
                            <field name="clearance_service_fee_account_id"/>
                        </setting>
                        <setting string="Miscellaneous Journal"
                                 help="Used for advance justification entries.">
                            <field name="clearance_misc_journal_id"/>
                        </setting>
                        <setting string="Sales Journal"
                                 help="Journal the client clearance invoice is raised in. Empty = the company's first sales journal.">
                            <field name="clearance_sale_journal_id"/>
                        </setting>
                    </block>

                    <block title="Billing">
                        <setting string="VAT on Service Fees"
                                 help="Applied to commission, customs fees and any other
                                       service line. Disbursements are never taxed here:
                                       they are the client's own liability paid on their
                                       behalf, outside the scope of VAT.">
                            <field name="clearance_service_tax_ids"
                                   widget="many2many_tags"/>
                        </setting>
                    </block>
                    <block title="Invoice Layout"
                           help="Only the wording the printed invoice invents.
                                 The logo, NIU, RC, address and bank accounts
                                 are read from the company itself, and the
                                 client block from the customer - so there is
                                 never a second copy to keep in step.">
                        <setting string="Invoice title"
                                 help="Printed above the invoice number.">
                            <field name="clearance_invoice_title"/>
                        </setting>
                        <setting string="VAT line label"
                                 help="The rate is appended automatically from the
                                       tax actually charged, e.g. (19,25%).">
                            <field name="clearance_invoice_vat_label"/>
                        </setting>
                        <setting string="Payment conditions"
                                 help="Used when the invoice carries no payment term
                                       of its own.">
                            <field name="clearance_invoice_payment_terms"/>
                        </setting>
                        <setting string="Complaints window (days)">
                            <field name="clearance_invoice_complaint_days"/>
                        </setting>
                        <setting string="Bank accounts on the invoice"
                                 help="Which accounts print, and in what order.
                                       Empty prints the first two the company has.
                                       Maintain the accounts themselves under
                                       Invoicing > Bank Accounts.">
                            <field name="clearance_invoice_bank_ids"
                                   widget="many2many_tags"/>
                        </setting>
                    </block>

                    <block title="Turnaround Targets"
                           help="How long each step of the workflow may take
                                 before Reporting flags it. An advance
                                 requested on Monday and paid on Friday shows
                                 as over target, so somebody can chase it.">
                        <setting string="Targets per step">
                            <button name="%(elite_clearance.action_clearance_turnaround_target)d"
                                    type="action" string="Set Targets"
                                    class="btn-link" icon="fa-arrow-right"/>
                        </setting>
                    </block>

                    <block title="Approvals">
                        <setting string="Waiver Approvers"
                                 help="Who may approve starting work with incomplete documentation. Empty = any Clearance Manager.">
                            <field name="clearance_waiver_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Expense Approvers"
                                 help="Who may approve expenses before disbursement. Empty = any Clearance Manager.">
                            <field name="clearance_expense_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Settlement Approvers"
                                 help="Who may approve the payment mode, vendor, holder and journal Finance has set on an expense. Empty = any Clearance Finance Manager.">
                            <field name="clearance_settlement_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Disbursement (Finance) Approvers"
                                 help="Who may settle disbursements and justify advances. Empty = any Clearance Finance user.">
                            <field name="clearance_finance_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Billing Approvers"
                                 help="Who may raise client invoices and mark files complete. Empty = any Clearance Finance user.">
                            <field name="clearance_billing_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Operations Close Approvers"
                                 help="Who may close a file for operations. Empty = any Clearance Operations Manager.">
                            <field name="clearance_ops_close_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Justification Approvers"
                                 help="Who may approve that the documents attached to a staff advance really justify it. Empty = any Clearance Operations Manager.">
                            <field name="clearance_justification_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Recharge Adjustment Approvers (Operations)"
                                 help="Who may approve recharging the client at other than cost. Empty = any Clearance Operations Manager.">
                            <field name="clearance_recharge_ops_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Below-Cost Recharge Approvers (General Manager)"
                                 help="Who must ALSO approve when the recharge is below what was disbursed — the company absorbs the difference. Empty = any Clearance Manager.">
                            <field name="clearance_recharge_gm_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Cashiers"
                                 help="Who may disburse from a cash till once the Finance Manager has approved the settlement. Empty = any Clearance Cashier.">
                            <field name="clearance_cashier_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Treasury"
                                 help="Who may pay from a bank or mobile-money journal once the Finance Manager has approved the settlement. Empty = any Clearance Treasury user.">
                            <field name="clearance_treasury_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Imported-File Reopening Approvers"
                                 help="Who may approve reopening a file imported from the legacy system so it can be worked and billed again. Empty = any Clearance Operations Manager.">
                            <field name="clearance_reopen_imported_approver_ids" widget="many2many_tags"/>
                        </setting>
                        <setting string="Unjustified Advance Waiver Approvers"
                                 help="Who may allow a file to be billed while a staff advance is still unsupported on 421101. Empty = any Clearance Operations Manager.">
                            <field name="clearance_advance_waiver_approver_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- No `target`: Odoo 19 dropped 'inline' from the act_window target
         selection, and the settings action is expected to open in the
         current window. Mirrors base_setup.action_general_configuration. -->
    <record id="action_clearance_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'elite_clearance', 'bin_size': False}</field>
    </record>

</odoo>
