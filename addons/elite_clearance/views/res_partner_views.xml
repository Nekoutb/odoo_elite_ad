<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_clearance" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.clearance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="clearance_slug" readonly="1"
                       groups="elite_clearance.group_clearance_user"
                       placeholder="set when the first file is opened"/>
            </xpath>
        </field>
    </record>

    <record id="res_partner_view_form_clearance_manager" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.clearance.manager</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="elite_clearance.res_partner_view_form_clearance"/>
        <field name="groups_id" eval="[(4, ref('elite_clearance.group_clearance_manager'))]"/>
        <field name="arch" type="xml">
            <!-- A Clearance Manager may correct a slug; everyone else reads it.
                 Correcting one does not rename analytic accounts already
                 created, and that is deliberate: those names sit on posted
                 lines and renaming them would rewrite history. -->
            <xpath expr="//field[@name='clearance_slug']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
