<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="logistics_port_view_list" model="ir.ui.view">
        <field name="name">logistics.port.list</field>
        <field name="model">logistics.port</field>
        <field name="arch" type="xml">
            <list string="Ports" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="city" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_logistics_port" model="ir.actions.act_window">
        <field name="name">Ports</field>
        <field name="res_model">logistics.port</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define the ports files are handled at</p>
            <p>Kribi, Douala, Tiko, Yaoundé. Each clearance file names the port it is cleared through.</p>
        </field>
    </record>

</odoo>
