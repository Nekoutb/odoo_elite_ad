<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_clearance_root" name="Clearance" sequence="85"
              web_icon="elite_clearance,static/description/icon.png"
              groups="group_clearance_user"/>

    <!-- Operations -->
    <!-- One child each, so the parent carries the action itself: clicking
         Files shows the files rather than a submenu of one. -->
    <menuitem id="menu_clearance_files" name="Files"
              parent="menu_clearance_root" action="action_logistics_file"
              sequence="10"/>

    <menuitem id="menu_clearance_expenses" name="Expenses"
              parent="menu_clearance_root" action="action_logistics_expense"
              sequence="20"/>

    <menuitem id="menu_clearance_billing" name="Billing"
              parent="menu_clearance_root" sequence="30"
              groups="group_clearance_billing,group_clearance_ops_manager"/>

    <menuitem id="menu_clearance_billing_services" name="Billable Services"
              parent="menu_clearance_billing"
              action="action_logistics_billing_service" sequence="10"/>

    <!-- Configuration -->
    <menuitem id="menu_clearance_config" name="Configuration"
              parent="menu_clearance_root" sequence="90"
              groups="group_clearance_manager"/>

    <menuitem id="menu_clearance_service_type" name="Service Types"
              parent="menu_clearance_config" action="action_logistics_service_type" sequence="10"/>

    <menuitem id="menu_clearance_document_type" name="Document Types"
              parent="menu_clearance_config" action="action_logistics_document_type" sequence="20"/>

    <menuitem id="menu_clearance_expense_category" name="Expense Categories"
              parent="menu_clearance_config" action="action_logistics_expense_category" sequence="30"/>

    <menuitem id="menu_clearance_port" name="Ports"
              parent="menu_clearance_config" action="action_logistics_port" sequence="40"/>

    <menuitem id="menu_clearance_settings" name="Settings"
              parent="menu_clearance_config" action="action_clearance_config_settings"
              sequence="90" groups="base.group_system"/>

</odoo>
