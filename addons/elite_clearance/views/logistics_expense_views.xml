<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="logistics_expense_view_form" model="ir.ui.view">
        <field name="name">logistics.expense.form</field>
        <field name="model">logistics.expense</field>
        <field name="arch" type="xml">
            <form string="Out-of-Pocket Expense">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="elite_clearance.group_clearance_ops_manager,elite_clearance.group_clearance_customer_service_manager,elite_clearance.group_clearance_transit_manager"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'submitted'"
                            groups="elite_clearance.group_clearance_ops_manager,elite_clearance.group_clearance_customer_service_manager,elite_clearance.group_clearance_transit_manager"/>
                    <button name="action_approve_settlement" type="object" string="Approve Settlement"
                            class="oe_highlight" invisible="state != 'approved'"
                            groups="elite_clearance.group_clearance_finance_manager"/>
                    <button name="action_settle" type="object" string="Settle (Post Payment)"
                            class="oe_highlight" invisible="state != 'settlement_approved'"
                            groups="elite_clearance.group_clearance_finance"/>
                    <button name="action_justify" type="object" string="Justify Advance"
                            class="oe_highlight"
                            invisible="state != 'settled' or payment_mode != 'advance'"
                            groups="elite_clearance.group_clearance_finance"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('submitted', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,settlement_approved,settled,justified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="file_id" readonly="state != 'draft'"/>
                            <field name="category_id" readonly="state not in ('draft', 'submitted')"/>
                            <field name="description" readonly="state not in ('draft', 'submitted')"/>
                            <field name="amount" readonly="state not in ('draft', 'submitted')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Settlement (Finance)" groups="elite_clearance.group_clearance_finance">
                            <field name="payment_mode" widget="radio" readonly="state != 'approved'"/>
                            <field name="vendor_id" readonly="state != 'approved'"/>
                            <field name="employee_id" invisible="payment_mode != 'advance'"
                                   required="payment_mode == 'advance'"
                                   readonly="state != 'approved'"/>
                            <field name="journal_id" readonly="state != 'approved'"/>
                            <field name="date_requested"/>
                            <field name="settlement_move_id" invisible="not settlement_move_id"/>
                            <field name="justification_move_id" invisible="not justification_move_id"/>
                            <field name="date_settled" invisible="not date_settled"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="logistics_expense_view_list" model="ir.ui.view">
        <field name="name">logistics.expense.list</field>
        <field name="model">logistics.expense</field>
        <field name="arch" type="xml">
            <list string="Out-of-Pocket Expenses" sample="1"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="file_id"/>
                <field name="category_id"/>
                <field name="description" optional="show"/>
                <field name="vendor_id" optional="show"/>
                <field name="payment_mode" optional="show"/>
                <field name="employee_id" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_legacy" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'submitted')"
                       decoration-warning="state in ('approved', 'settlement_approved')"
                       decoration-success="state in ('settled', 'justified')"/>
            </list>
        </field>
    </record>

    <record id="logistics_expense_view_search" model="ir.ui.view">
        <field name="name">logistics.expense.search</field>
        <field name="model">logistics.expense</field>
        <field name="arch" type="xml">
            <search string="Expenses">
                <field name="name"/>
                <field name="file_id"/>
                <field name="vendor_id"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="legacy" string="Legacy (Teese)" domain="[('is_legacy', '=', True)]"/>
                <filter name="legacy_unjustified" string="Legacy, unjustified" domain="[('is_legacy', '=', True), ('legacy_justified', '=', False), ('legacy_reversal', '=', False)]"/>
                <separator/>
                <filter name="to_set_settlement" string="Settlement To Set (Finance)" domain="[('state', '=', 'approved')]"/>
                <filter name="to_approve_settlement" string="Settlement To Approve" domain="[('state', '=', 'approved'), ('payment_mode', '!=', False)]"/>
                <filter name="to_settle" string="To Settle" domain="[('state', '=', 'settlement_approved')]"/>
                <filter name="to_justify" string="Advances To Justify"
                        domain="[('state', '=', 'settled'), ('payment_mode', '=', 'advance')]"/>
                <group>
                    <filter name="group_file" string="File" context="{'group_by': 'file_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Advance Holder" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_expense" model="ir.actions.act_window">
        <field name="name">Out-of-Pocket Expenses</field>
        <field name="res_model">logistics.expense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Capture an out-of-pocket expense</p>
            <p>Customs duty, port charges, transport — captured on the file, approved, settled through Cash, Bank, Mobile Money or Maviance, and recharged to the client at billing.</p>
        </field>
    </record>

    <record id="logistics_expense_category_view_list" model="ir.ui.view">
        <field name="name">logistics.expense.category.list</field>
        <field name="model">logistics.expense.category</field>
        <field name="arch" type="xml">
            <list string="Expense Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_logistics_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">logistics.expense.category</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
