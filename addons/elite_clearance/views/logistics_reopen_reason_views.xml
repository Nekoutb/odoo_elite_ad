<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Configuration -> Reopening Reasons (owner 16/10/2026) -->
    <record id="logistics_reopen_reason_view_list" model="ir.ui.view">
        <field name="name">logistics.reopen.reason.list</field>
        <field name="model">logistics.reopen.reason</field>
        <field name="arch" type="xml">
            <list string="Reopening Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="target_state"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_logistics_reopen_reason" model="ir.actions.act_window">
        <field name="name">Reopening Reasons</field>
        <field name="res_model">logistics.reopen.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reopening reasons yet</p>
            <p>Every reopening of a file takes one of these, so they can be
            counted under Reporting → Reopenings.</p>
        </field>
    </record>

    <!-- Reporting -> Reopenings: one row per reopening -->
    <record id="logistics_file_reopening_view_list" model="ir.ui.view">
        <field name="name">logistics.file.reopening.list</field>
        <field name="model">logistics.file.reopening</field>
        <field name="arch" type="xml">
            <list string="Reopenings" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="file_id"/>
                <field name="partner_id"/>
                <field name="service_type_id" optional="show"/>
                <field name="customs_regime" optional="show"/>
                <field name="reason_id"/>
                <field name="from_state" optional="hide"/>
                <field name="target_state"/>
                <field name="user_id"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="logistics_file_reopening_view_pivot" model="ir.ui.view">
        <field name="name">logistics.file.reopening.pivot</field>
        <field name="model">logistics.file.reopening</field>
        <field name="arch" type="xml">
            <pivot string="Reopenings">
                <field name="reason_id" type="row"/>
                <field name="date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="logistics_file_reopening_view_graph" model="ir.ui.view">
        <field name="name">logistics.file.reopening.graph</field>
        <field name="model">logistics.file.reopening</field>
        <field name="arch" type="xml">
            <graph string="Reopenings" type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="reason_id"/>
            </graph>
        </field>
    </record>

    <record id="logistics_file_reopening_view_search" model="ir.ui.view">
        <field name="name">logistics.file.reopening.search</field>
        <field name="model">logistics.file.reopening</field>
        <field name="arch" type="xml">
            <search string="Reopenings">
                <field name="file_id"/>
                <field name="partner_id"/>
                <field name="reason_id"/>
                <filter name="to_operations" string="To operations" domain="[('target_state', '=', 'in_progress')]"/>
                <filter name="to_billing" string="To billing" domain="[('target_state', '=', 'ops_closed')]"/>
                <separator/>
                <filter name="this_month" string="This month" date="date" default_period="month"/>
                <group>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'reason_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_service" string="Service Type" context="{'group_by': 'service_type_id'}"/>
                    <filter name="group_regime" string="Customs Regime" context="{'group_by': 'customs_regime'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_file_reopening" model="ir.actions.act_window">
        <field name="name">Reopenings</field>
        <field name="res_model">logistics.file.reopening</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_group_reason': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No file has been reopened yet</p>
            <p>Every reopening of a file lands here with its reason, so they can be
            counted by reason, by month, by client or by regime.</p>
        </field>
    </record>

</odoo>
