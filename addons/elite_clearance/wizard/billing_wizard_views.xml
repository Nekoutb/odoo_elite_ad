<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="billing_wizard_view_form" model="ir.ui.view">
        <field name="name">logistics.billing.wizard.form</field>
        <field name="model">logistics.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Billing">
                <field name="file_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="needs_review" invisible="1"/>
                <field name="reissue_kind" invisible="1"/>
                <field name="billed_before" invisible="1"/>
                <field name="review_mode" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="not review_mode">
                    <b>Recharge review.</b> This is the bill as the biller proposes it. The
                    Why column says why each disbursement is charged at other than cost.
                    Approve or refuse it below; nothing here can be edited.
                </div>
                <div class="alert alert-info" role="alert" invisible="not billed_before">
                    This file has been billed before. Only what has been incurred since is on
                    this invoice — everything already recharged is listed below, greyed, and
                    cannot be charged again.
                </div>
                <div class="alert alert-info" role="alert" invisible="not reissue_kind">
                    <field name="standing_invoice_id" readonly="1" class="fw-bold"/>
                    stands and stays as it is. Only the
                    <b><field name="reissue_kind" readonly="1" class="d-inline"/></b>
                    invoice of the split bill is issued again.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not needs_review">
                    <b>The recharge no longer matches what was disbursed.</b>
                    No invoice can be raised until an Head of Service Operations approves it — and where the
                    recharge is <i>below</i> cost, the General Manager as well. Give the reason and
                    send it for review.
                </div>
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="invoice_total" readonly="1"/>
                    </group>
                </group>

                <field name="client_details_missing" invisible="1"/>
                <field name="shipment_details_missing" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not client_details_missing">
                    This client's record is missing details the invoice
                    prints. Fill them in below - they are saved to the
                    customer, not just to this invoice.
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not shipment_details_missing">
                    This file was opened without shipment details the invoice
                    prints. Fill them in below - they are saved to the file.
                </div>
                <separator string="Printed on the invoice"/>
                <group>
                    <group string="Client">
                        <!-- First, and first on the printed page: the short
                             name beside it is the handle everyone searches
                             by, not what a client should read on their bill. -->
                        <field name="client_name" required="1" readonly="review_mode"
                               placeholder="e.g. CAPITAL TRADING PRIVATE LTD"/>
                        <field name="client_street" readonly="review_mode"/>
                        <field name="client_email" readonly="review_mode"/>
                        <field name="client_vat" readonly="review_mode"/>
                        <field name="client_registry" readonly="review_mode"/>
                    </group>
                    <group string="Shipment">
                        <field name="shipment_bl_awb_ref" readonly="review_mode"/>
                        <field name="shipment_goods" readonly="review_mode"/>
                        <field name="shipment_cargo_value" readonly="review_mode"/>
                    </group>
                </group>

                <separator string="Billing parameters"/>
                <group>
                    <group>
                        <field name="commission_rate" readonly="review_mode"/>
                        <field name="commission_amount" readonly="1"/>
                        <field name="customs_fee_amount" readonly="review_mode"/>
                        <field name="customs_fee_billed" readonly="1"
                               invisible="not customs_fee_billed"/>
                        <field name="file_fee_amount" readonly="review_mode"/>
                        <field name="file_fee_billed" readonly="1"
                               invisible="not file_fee_billed"/>
                        <field name="commission_billed" readonly="1"
                               invisible="not commission_billed"/>
                        <field name="split_invoices" readonly="reissue_kind or review_mode"/>
                    </group>
                    <group string="Advances already paid by the client">
                        <field name="advance_had_amount" readonly="1"/>
                        <field name="advance_had_vat_amount" readonly="1"/>
                        <field name="advance_other_amount" readonly="1"/>
                        <div class="text-muted" colspan="2">
                            None of these is typed. The first two follow the Honoraires Agréés
                            en Douane above; the third is every posting that credits this
                            client's account carrying this file's analytic — record the advance
                            in Accounting and it appears here.
                        </div>
                    </group>
                </group>

                <separator string="Out-of-pocket expenses (débours)"/>
                <field name="debours_line_ids" readonly="review_mode">
                    <list editable="bottom" create="0" delete="0">
                        <field name="expense_id" column_invisible="1" force_save="1"/>
                        <field name="name" readonly="1" force_save="1"/>
                        <field name="unit_label" column_invisible="1" force_save="1"/>
                        <field name="amount_engaged" sum="Disbursed" readonly="1"/>
                        <field name="amount_recharged" sum="Recharged"/>
                        <field name="variance" sum="Variance"
                               decoration-danger="variance &lt; 0"
                               decoration-success="variance &gt; 0"/>
                        <field name="comment" placeholder="why it differs from cost"
                               required="variance != 0"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="text-muted mt-1" invisible="not debours_line_ids">
                    The invoice always recharges disbursements at cost, so the out-of-pocket account
                    clears in full. Any difference is billed as one further line — an undercharge is
                    booked as a cost, an overcharge as revenue.
                </div>

                <separator string="Already billed" invisible="not billed_line_ids"/>
                <field name="billed_line_ids" invisible="not billed_line_ids" readonly="1">
                    <list create="0" delete="0" edit="0" decoration-muted="1">
                        <field name="expense_id" column_invisible="1"/>
                        <field name="name"/>
                        <field name="amount" sum="Already billed"/>
                        <field name="invoice_id"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="text-muted mt-1 mb-2" invisible="not billed_line_ids">
                    Recharged on an invoice that stands. To bill one of these again, credit its
                    line on that invoice first — it then comes back to the section above.
                </div>

                <separator string="Additional services"/>
                <div class="text-muted mb-1">
                    Anything beyond the commission and the customs fee. Only services an
                    Head of Service Operations has approved can be picked here.
                </div>
                <field name="service_line_ids" readonly="review_mode">
                    <list editable="bottom">
                        <field name="service_id" options="{'no_create': True}"/>
                        <field name="name" placeholder="e.g. Frais d'ouverture de dossier"/>
                        <field name="unit_label"/>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="amount" sum="Services"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>

                <group class="oe_subtotal_footer">
                    <field name="debours_engaged_total" readonly="1"/>
                    <field name="debours_recharged_total" readonly="1"/>
                    <field name="debours_variance" readonly="1"
                           invisible="not debours_variance"/>
                    <field name="service_total" readonly="1"/>
                    <field name="service_tax_total" readonly="1"
                           invisible="not service_tax_total"/>
                    <field name="invoice_total" readonly="1" class="oe_subtotal_footer_separator"/>
                    <field name="split_debours_total" readonly="1" invisible="not split_invoices"/>
                    <field name="split_services_total" readonly="1" invisible="not split_invoices"/>
                </group>

                <field name="review_reason" invisible="not needs_review" readonly="review_mode"
                       placeholder="Optional: anything about the adjustment as a whole. Each line that differs already says why in its Why column."/>

                <footer>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            class="btn-primary" invisible="needs_review or review_mode"/>
                    <button name="action_submit_for_review" type="object" string="Submit for Review"
                            class="btn-primary" invisible="not needs_review or review_mode"/>
                    <button name="action_approve_review" type="object" string="Approve the Recharge"
                            class="btn-primary" invisible="not review_mode"/>
                    <button name="action_refuse_review" type="object" string="Refuse..."
                            class="btn-danger" invisible="not review_mode"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_billing_wizard" model="ir.actions.act_window">
        <field name="name">Billing</field>
        <field name="res_model">logistics.billing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
