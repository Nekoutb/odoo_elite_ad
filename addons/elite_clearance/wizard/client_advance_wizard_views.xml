<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="client_advance_wizard_view_form" model="ir.ui.view">
        <field name="name">logistics.client.advance.wizard.form</field>
        <field name="model">logistics.client.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Client Advance">
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    The money is received against the client's own account and carries this
                    file's analytic tag, like everything else the file touches. It is posted
                    straight away and comes off the invoice, so the client reads what is
                    actually left to pay.
                </div>
                <group>
                    <group>
                        <field name="file_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="memo" placeholder="e.g. the transfer reference"/>
                        <field name="already_received" readonly="1"
                               invisible="not already_received"/>
                    </group>
                </group>
                <footer>
                    <button name="action_record_advance" type="object"
                            string="Record the Advance" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_client_advance_wizard" model="ir.actions.act_window">
        <field name="name">Client Advance</field>
        <field name="res_model">logistics.client.advance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
