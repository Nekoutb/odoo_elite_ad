<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="expense_capture_wizard_view_form" model="ir.ui.view">
        <field name="name">logistics.expense.capture.wizard.form</field>
        <field name="model">logistics.expense.capture.wizard</field>
        <field name="arch" type="xml">
            <form string="Add a Disbursement">
                <field name="file_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="category_id" options="{'no_create': True}"/>
                        <field name="description"
                               placeholder="e.g. container MSCU1234567, 2 days"/>
                    </group>
                    <group>
                        <!-- who is paid comes BEFORE the amount (owner
                             16/10/2026): a manifesting vendor reveals the
                             manifesting date, to be keyed first -->
                        <field name="company_id" invisible="1"/>
                        <field name="needs_manifesting_date" invisible="1"/>
                        <field name="vendor_id" options="{'no_create': True}"
                               readonly="is_advance" placeholder="who is paid"/>
                        <field name="manifesting_date"
                               invisible="not needs_manifesting_date"
                               required="needs_manifesting_date"/>
                        <field name="amount"/>
                        <field name="date_requested"/>
                    </group>
                </group>
                <group string="Payment (Finance may change it)">
                    <field name="journal_id" widget="selection"
                           placeholder="till, bank, Mobile Money, Maviance"/>
                    <!-- a supplier OR an advance to the requester: each greys
                         the other (owner 13/10/2026: the holder is not chosen,
                         it is whoever keys the advance) -->
                    <field name="is_advance" readonly="vendor_id"/>
                    <field name="employee_id" invisible="not is_advance"/>
                    <!-- who walks to the till: the requester unless they say
                         otherwise - administrative, printed on the voucher -->
                    <field name="collector_id" options="{'no_create': True}"
                           placeholder="you, unless somebody else collects it"/>
                </group>
                <separator string="Documents"/>
                <!-- The widget makes the whole dialog a drop target: a receipt
                     dragged anywhere onto it is uploaded and listed here, and
                     follows the disbursement when it is created. -->
                <field name="attachment_ids" widget="clearance_documents"
                       nolabel="1" colspan="2"/>
                <div class="text-muted mt-2">
                    Submitting sends it straight to the head of your service. Once approved
                    it lands with Finance, who may change the channel and the counterparty
                    before sending it on for payment.
                </div>
                <footer>
                    <button name="action_submit_close" type="object"
                            string="Submit" class="btn-primary"/>
                    <button name="action_submit_new" type="object"
                            string="Submit &amp; Add New" class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_expense_capture_wizard" model="ir.actions.act_window">
        <field name="name">Add a Disbursement</field>
        <field name="res_model">logistics.expense.capture.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
