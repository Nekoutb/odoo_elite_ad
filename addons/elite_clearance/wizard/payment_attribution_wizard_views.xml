<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_attribution_wizard_view_form" model="ir.ui.view">
        <field name="name">logistics.payment.attribution.wizard.form</field>
        <field name="model">logistics.payment.attribution.wizard</field>
        <field name="arch" type="xml">
            <form string="Advance on a clearance file">
                <field name="currency_id" invisible="1"/>
                <field name="candidate_count" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="not candidate_count">
                    Taking this receipt against a file tags every line of its journal entry
                    with that file's analytic account, and the billing screen then shows it
                    under <b>Other advances</b> — nothing to type there.
                </div>
                <div class="alert alert-warning" role="alert" invisible="candidate_count">
                    This customer has no open clearance file. Open one first, or leave the
                    receipt on account until there is a file to put it against.
                </div>
                <group>
                    <group>
                        <field name="payment_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="date" readonly="1"/>
                        <field name="journal_id" readonly="1"/>
                        <field name="current_file_id" readonly="1"
                               invisible="not current_file_id"/>
                    </group>
                </group>

                <separator string="Open files for this customer"
                           invisible="not candidate_count"/>
                <field name="candidate_ids" readonly="1" nolabel="1"
                       invisible="not candidate_count">
                    <list create="0" delete="0" edit="0">
                        <field name="name"/>
                        <field name="service_type_id"/>
                        <field name="bl_awb_ref" optional="show"/>
                        <field name="date_opened"/>
                        <field name="stage_owner" string="Sitting with"/>
                        <field name="advance_other_amount" string="Already advanced"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>

                <group invisible="not candidate_count">
                    <field name="file_id" required="1"
                           options="{'no_create': True}"/>
                </group>

                <footer>
                    <button name="action_attribute" type="object"
                            string="Put it against this file" class="btn-primary"
                            invisible="not candidate_count"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payment_attribution_wizard" model="ir.actions.act_window">
        <field name="name">Which file is this advance for?</field>
        <field name="res_model">logistics.payment.attribution.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
