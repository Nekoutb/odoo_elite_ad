<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="clearance_rejection_wizard_view_form" model="ir.ui.view">
        <field name="name">clearance.rejection.wizard.form</field>
        <field name="model">clearance.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <field name="method" invisible="1"/>
                <p class="text-muted">
                    The reason is posted on the record and sent to the person who asked,
                    so they can see what to change.
                </p>
                <field name="reason" placeholder="Why is this refused, and what would make it acceptable?"/>
                <footer>
                    <button name="action_confirm" type="object" string="Refuse"
                            class="btn-danger"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
