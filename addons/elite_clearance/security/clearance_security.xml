<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_clearance" model="res.groups.privilege">
        <field name="name">Clearance</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_clearance_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('analytic.group_analytic_accounting'))]"/>
        <field name="comment">Can open clearance files, tick documents and request a waiver. Implies Analytic Accounting, because every file shows its own analytic account.</field>
    </record>


    <!-- ================================================================
         Originating teams. An expense is keyed by one of these and never
         by Finance: the person who spends is not the person who pays.
         Each team's manager approves its expenses.
         ================================================================ -->

    <record id="group_clearance_operations" model="res.groups">
        <field name="name">Operations</field>
        <field name="sequence">12</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user'))]"/>
        <field name="comment">Operations team. May key out-of-pocket expenses on a file.</field>
    </record>

    <record id="group_clearance_customer_service" model="res.groups">
        <field name="name">Customer Service</field>
        <field name="sequence">13</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user'))]"/>
        <field name="comment">Customer service team. May key out-of-pocket expenses on a file.</field>
    </record>

    <record id="group_clearance_customer_service_manager" model="res.groups">
        <field name="name">Customer Service Manager</field>
        <field name="sequence">14</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_customer_service'))]"/>
        <field name="comment">Approves expenses submitted by any originating team.</field>
    </record>

    <record id="group_clearance_transit" model="res.groups">
        <field name="name">Transit</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user'))]"/>
        <field name="comment">Transit team. May key out-of-pocket expenses on a file.</field>
    </record>

    <record id="group_clearance_transit_manager" model="res.groups">
        <field name="name">Transit Manager</field>
        <field name="sequence">16</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_transit'))]"/>
        <field name="comment">Approves expenses submitted by any originating team.</field>
    </record>

    <record id="group_clearance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything a User can do, plus approving documentation waivers, cancelling live files and maintaining service and document types.</field>
    </record>

    <record id="group_clearance_ops_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_operations'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages the Operations team and owns the operational consequences of a file: approves expenses from any originating team, alone may close a file for operations, and alone may waive an unjustified staff advance so a file can be billed — deliberately a different authority from Finance, who pays.</field>
    </record>

    <record id="group_clearance_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Determines how an approved expense is paid — payment mode, vendor, advance holder, journal — then settles it, justifies advances and raises client invoices. Never keys an expense: the person who pays is not the person who spends. Implies Invoicing access.</field>
    </record>

    <record id="group_clearance_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="sequence">32</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Disburses cash from a till once the Finance Manager has approved the settlement.</field>
    </record>

    <record id="group_clearance_treasury" model="res.groups">
        <field name="name">Treasury</field>
        <field name="sequence">33</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Pays from a bank or mobile-money journal once the Finance Manager has approved the settlement.</field>
    </record>

    <record id="group_clearance_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="sequence">35</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_finance'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Approves the settlement method Finance has proposed on an expense before any money leaves. Implies Finance.</field>
    </record>


</odoo>
