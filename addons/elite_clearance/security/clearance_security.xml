<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_clearance" model="res.groups.privilege">
        <field name="name">Clearance</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_clearance_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('analytic.group_analytic_accounting'))]"/>
        <field name="comment">Can open clearance files, tick documents and request a waiver. Implies Analytic Accounting, because every file shows its own analytic account.</field>
    </record>

    <record id="group_clearance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything a User can do, plus approving documentation waivers and maintaining service and document types.</field>
    </record>

    <record id="group_clearance_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_clearance"/>
        <field name="implied_ids" eval="[(4, ref('group_clearance_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Settles expenses, justifies advances and raises client invoices. Implies Invoicing access.</field>
    </record>

    <data noupdate="1">
        <record id="rule_logistics_file_company" model="ir.rule">
            <field name="name">Clearance file: own companies only</field>
            <field name="model_id" ref="model_logistics_file"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_logistics_expense_company" model="ir.rule">
            <field name="name">Clearance expense: own companies only</field>
            <field name="model_id" ref="model_logistics_expense"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_logistics_file_document_company" model="ir.rule">
            <field name="name">Clearance file document: own companies only</field>
            <field name="model_id" ref="model_logistics_file_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>

</odoo>
