<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company isolation. Global rules (no groups), so they apply
             to every user including administrators; sudo() still bypasses
             them, which is what the analytic-account creation relies on. -->

        <record id="rule_logistics_file_company" model="ir.rule">
            <field name="name">Clearance file: own companies only</field>
            <field name="model_id" ref="model_logistics_file"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Owner 10/10/2026: once Customer Service has opened a file,
             every clearance team - Customer Service, Operations, Transit,
             their heads, Finance - sees it under Files, draft included.
             This REVERSES the 08/09/2026 rule that kept a draft to its
             author until work started; that rule
             (rule_logistics_file_draft_is_the_authors) is deleted by the
             19.0.47.0.0 migration, because this file is noupdate and a
             rule already in a database is never rewritten on upgrade.
             Rules with groups are OR-ed together; the company rule above
             is global and still applies on top. -->

        <record id="rule_logistics_file_team_sees_every_file" model="ir.rule">
            <field name="name">Clearance file: every clearance team sees every file</field>
            <field name="model_id" ref="model_logistics_file"/>
            <field name="groups" eval="[(4, ref('group_clearance_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_logistics_file_manager_sees_all" model="ir.rule">
            <field name="name">Clearance file: a manager sees every file</field>
            <field name="model_id" ref="model_logistics_file"/>
            <field name="groups" eval="[(4, ref('group_clearance_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- The Head of Customer Service too: the files their agents open
             wait in draft for their approval (02/10/2026). A rule of its
             own, not a group added to the one above: this file is
             noupdate, so an existing rule is never changed on upgrade. -->
        <record id="rule_logistics_file_cs_head_sees_all" model="ir.rule">
            <field name="name">Clearance file: the Head of Customer Service sees every file</field>
            <field name="model_id" ref="model_logistics_file"/>
            <field name="groups" eval="[(4, ref('group_clearance_customer_service_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- The checklist follows its file, which is now everybody's. The
             old rule_logistics_file_document_draft goes with the file
             rule, in the same migration. -->

        <record id="rule_logistics_file_document_team" model="ir.rule">
            <field name="name">Clearance checklist: every clearance team sees every one</field>
            <field name="model_id" ref="model_logistics_file_document"/>
            <field name="groups" eval="[(4, ref('group_clearance_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_logistics_file_document_manager" model="ir.rule">
            <field name="name">Clearance checklist: a manager sees every one</field>
            <field name="model_id" ref="model_logistics_file_document"/>
            <field name="groups" eval="[(4, ref('group_clearance_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_logistics_file_document_cs_head" model="ir.rule">
            <field name="name">Clearance checklist: the Head of Customer Service sees every one</field>
            <field name="model_id" ref="model_logistics_file_document"/>
            <field name="groups" eval="[(4, ref('group_clearance_customer_service_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_logistics_file_document_company" model="ir.rule">
            <field name="name">Clearance file document: own companies only</field>
            <field name="model_id" ref="model_logistics_file_document"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_logistics_expense_company" model="ir.rule">
            <field name="name">Clearance expense: own companies only</field>
            <field name="model_id" ref="model_logistics_expense"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Master data is seeded per company by the post-install hook, so it
             needs the same isolation. company_id = False means "shared by
             every company" and stays visible. -->

        <record id="rule_logistics_document_type_company" model="ir.rule">
            <field name="name">Clearance document type: own companies only</field>
            <field name="model_id" ref="model_logistics_document_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_logistics_service_type_company" model="ir.rule">
            <field name="name">Clearance service type: own companies only</field>
            <field name="model_id" ref="model_logistics_service_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_logistics_expense_category_company" model="ir.rule">
            <field name="name">Clearance expense category: own companies only</field>
            <field name="model_id" ref="model_logistics_expense_category"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
