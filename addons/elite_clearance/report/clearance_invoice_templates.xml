<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    The clearance invoice as Elimelec issues it. Everything that exists
    elsewhere in Odoo is read from there and never re-keyed: the company's
    NIU and RC are its Tax ID and Company Registry, the bank blocks are its
    own bank accounts, the client block is the partner. Only the wording
    the document invents - the title, the payment conditions, the
    complaints window - is configured, in Settings > Clearance.

    Borders follow the paper document, owner 05/09/2026: the two identity
    boxes and the cargo box carry an OUTER FRAME ONLY, and the line table
    has column rules but no rules between rows.
  -->

  <template id="report_clearance_invoice_document">
    <t t-set="o" t-value="o.with_context(lang=o._clearance_report_lang())"/>
    <t t-set="file" t-value="o.logistics_file_id"/>
    <t t-set="company" t-value="o.company_id"/>
    <t t-set="partner" t-value="o.partner_id"/>
    <t t-set="cur" t-value="o.currency_id"/>
    <div class="page o_clearance_invoice">

      <style>
        .o_clearance_invoice { font-size: 11px; color: #000; }
        /* Several documents in one print - a split bill's pair from
           Preview - each start on their own page. The legacy property:
           wkhtmltopdf's WebKit does not know break-before. */
        .o_clearance_invoice + .o_clearance_invoice { page-break-before: always; }
        .o_clearance_invoice table { width: 100%; border-collapse: collapse; }
        /* Identity and cargo boxes: outer frame only. The inner tables
           carry no borders at all - the frame is on the wrapper. */
        .o_clearance_invoice .frame { border: 1px solid #000;
                                      padding: 4px 6px; }
        .o_clearance_invoice .frame td { padding: 1px 2px;
                                         vertical-align: top; }
        .o_clearance_invoice .frame td.lbl { font-weight: bold; }
        /* Line table: outer frame plus COLUMN rules. No row rules. */
        .o_clearance_invoice .lines { border: 1px solid #000; }
        .o_clearance_invoice .lines th,
        .o_clearance_invoice .lines td { padding: 2px 5px; }
        .o_clearance_invoice .lines th { background: #d9d9d9;
                                         text-align: center;
                                         font-weight: bold;
                                         border-bottom: 1px solid #000; }
        .o_clearance_invoice .lines th + th,
        .o_clearance_invoice .lines td + td { border-left: 1px solid #000; }
        .o_clearance_invoice .lines td.num { text-align: right;
                                             white-space: nowrap; }
        .o_clearance_invoice .lines td.ctr { text-align: center; }
        .o_clearance_invoice .lines tr.sub td { font-weight: bold; }
        .o_clearance_invoice .totals td { border: 1px solid #000;
                                          padding: 3px 6px;
                                          font-weight: bold; }
        .o_clearance_invoice .totals td.num { text-align: right;
                                              white-space: nowrap; }
        .o_clearance_invoice .bank td { border: 0; padding: 1px 4px;
                                        font-style: italic; font-size: 10px;
                                        vertical-align: top; }
        .o_clearance_invoice .bankbox { border: 1px solid #000; padding: 5px 6px; }
        .o_clearance_invoice h2 { font-size: 20px; margin: 0; font-weight: bold; }
        .o_clearance_invoice .foot { text-align: center; font-size: 9px;
                                     border-top: 1px solid #000;
                                     padding-top: 4px; margin-top: 10px; }
      </style>

      <!-- masthead -->
      <table style="margin-bottom:12px;">
        <tr>
          <td style="width:45%; vertical-align:top;">
            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                 style="max-height:70px;" alt="Logo"/>
          </td>
          <td style="text-align:right; vertical-align:top;">
            <div><span t-esc="company.clearance_invoice_title or 'Facture doit N°'"/></div>
            <h2><span t-field="o.name"/></h2>
            <div><span t-field="o.invoice_date"/></div>
          </td>
        </tr>
      </table>

      <!-- identity: two boxes of equal width, stretched to equal height -->
      <table style="margin-bottom:6px;">
        <tr>
          <td style="width:50%; padding-right:3px; vertical-align:stretch;">
            <div class="frame" style="height:100%;">
              <table t-if="file">
                <tr>
                  <td class="lbl" style="width:50%;">N° BL/N° LTA</td>
                  <td class="lbl">Reference</td>
                </tr>
                <tr>
                  <td><span t-field="file.bl_awb_ref"/></td>
                  <td><span t-field="file.client_reference"/></td>
                </tr>
                <tr>
                  <td class="lbl">N° Dossier</td>
                  <td class="lbl">Fournisseur</td>
                </tr>
                <tr>
                  <td><span t-field="file.name"/></td>
                  <td><span t-field="file.supplier_name"/></td>
                </tr>
                <tr>
                  <td class="lbl">Produits</td>
                  <td class="lbl">Valeur RVC</td>
                </tr>
                <tr>
                  <td><span t-field="file.goods_description"/></td>
                  <td>
                    <span t-field="file.cargo_value"
                          t-options="{'widget': 'monetary',
                                      'display_currency': file.cargo_value_currency_id or cur}"/>
                  </td>
                </tr>
              </table>
              <table t-else="">
                <tr><td class="lbl">Référence</td></tr>
                <tr><td><span t-field="o.invoice_origin"/></td></tr>
              </table>
            </div>
          </td>
          <td style="width:50%; padding-left:3px; vertical-align:stretch;">
            <div class="frame" style="height:100%;">
              <table>
                <tr><td class="lbl"><span t-field="partner.name"/></td></tr>
                <tr><td>
                  <span t-field="partner.street"/>
                  <t t-if="partner.street2"> - <span t-field="partner.street2"/></t>
                </td></tr>
                <tr><td><span t-field="partner.phone"/></td></tr>
                <tr><td><span t-field="partner.email"/></td></tr>
                <tr><td>
                  <span t-field="partner.vat"/>
                  <span style="margin-left:18px;" t-field="partner.company_registry"/>
                </td></tr>
              </table>
            </div>
          </td>
        </tr>
      </table>

      <!-- the cargo itself: outer frame only -->
      <div class="frame" style="margin-bottom:8px;" t-if="file">
        <table>
          <tr>
            <td class="lbl" style="width:25%;">NBRE TC</td>
            <td class="lbl" style="width:25%;">Type de TC</td>
            <td class="lbl" style="width:25%;">POIDS (KG)</td>
            <td class="lbl" style="width:25%;">NBRE DE COLIS</td>
          </tr>
          <tr>
            <!-- goods that are not in a container print a dash, not a
                 zero and a blank; the weight and the package count still
                 belong on the page -->
            <td t-if="file.not_containerised">-</td>
            <td t-else=""><span t-field="file.container_count"/></td>
            <td t-if="file.not_containerised">-</td>
            <td t-else=""><span t-field="file.container_type"/></td>
            <td><span t-esc="o._clearance_money(file.weight_kg)"/></td>
            <td><span t-field="file.package_count"/></td>
          </tr>
        </table>
      </div>

      <!-- what is charged -->
      <t t-set="products" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"/>
      <t t-set="debours" t-value="products.filtered(lambda l: l.clearance_category == 'debours')"/>
      <t t-set="prestations" t-value="products.filtered(lambda l: l.clearance_category == 'prestation')"/>
      <t t-set="other" t-value="products.filtered(lambda l: not l.clearance_category)"/>

      <table class="lines" style="margin-bottom:10px;">
        <thead>
          <tr>
            <th style="width:11%;">Catégorie</th>
            <th>Désignation</th>
            <th style="width:13%;">Unité</th>
            <th style="width:8%;">Quantité</th>
            <th style="width:14%;">Prix unitaire</th>
            <th style="width:14%;">Montant</th>
          </tr>
        </thead>
        <tbody>
          <!-- A disbursement prints at what the CLIENT is charged. The
               line posts at cost and the difference is a separate
               accounting line, which the client never sees: the invoice
               says what is being billed, not what it cost us. -->
          <tr t-foreach="debours" t-as="line">
            <td>Debours</td>
            <td><span t-field="line.name"/></td>
            <td><span t-field="line.clearance_unit"/></td>
            <td class="ctr"><span t-esc="'{:,.2f}'.format(line.quantity).rstrip('0').rstrip('.').replace(',', ' ')"/></td>
            <td class="num"><span t-esc="o._clearance_money(line.price_subtotal + line.clearance_adjustment)"/></td>
            <td class="num"><span t-esc="o._clearance_money(line.price_subtotal + line.clearance_adjustment)"/></td>
          </tr>
          <tr class="sub" t-if="debours">
            <td>Sous total</td>
            <td></td>
            <td></td>
            <td class="ctr"><span t-esc="len(debours)"/></td>
            <td></td>
            <td class="num"><span t-esc="o._clearance_money(sum(debours.mapped('price_subtotal')) + sum(debours.mapped('clearance_adjustment')))"/></td>
          </tr>

          <tr t-foreach="prestations" t-as="line">
            <td>Prestations</td>
            <td><span t-field="line.name"/></td>
            <td><span t-field="line.clearance_unit"/></td>
            <td class="ctr"><span t-esc="'{:,.2f}'.format(line.quantity).rstrip('0').rstrip('.').replace(',', ' ')"/></td>
            <td class="num"><span t-esc="o._clearance_money(line.price_unit)"/></td>
            <td class="num"><span t-esc="o._clearance_money(line.price_subtotal)"/></td>
          </tr>
          <tr class="sub" t-if="prestations">
            <td>Sous total</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td class="num"><span t-esc="o._clearance_money(sum(prestations.mapped('price_subtotal')))"/></td>
          </tr>

          <tr t-foreach="other" t-as="line">
            <td></td>
            <td><span t-field="line.name"/></td>
            <td><span t-field="line.clearance_unit"/></td>
            <td class="ctr"><span t-esc="'{:,.2f}'.format(line.quantity).rstrip('0').rstrip('.').replace(',', ' ')"/></td>
            <td class="num"><span t-esc="o._clearance_money(line.price_unit)"/></td>
            <td class="num"><span t-esc="o._clearance_money(line.price_subtotal)"/></td>
          </tr>
        </tbody>
      </table>

      <!-- totals, and what the client has already advanced -->
      <!-- A split bill deducts only its own side's advances and, on the
           disbursements invoice, prints no VAT row: there is none. -->
      <t t-set="adv" t-value="o._clearance_advances() if file else (None, None, None)"/>
      <t t-set="advances" t-value="o._clearance_advance_total() if file else 0.0"/>
      <t t-set="due" t-value="o.amount_total - advances"/>
      <table style="margin-bottom:8px;">
        <tr>
          <td style="width:48%;"></td>
          <td>
            <table class="totals">
              <tr>
                <td>TOTAL HT</td>
                <td class="num"><span t-esc="o._clearance_money(o.amount_untaxed)"/> <span t-field="cur.name"/></td>
              </tr>
              <tr t-if="o._clearance_prints_vat()">
                <td><span t-esc="o._clearance_service_tax_label()"/></td>
                <td class="num"><span t-esc="o._clearance_money(o.amount_tax)"/> <span t-field="cur.name"/></td>
              </tr>
              <tr>
                <td>TOTAL TTC</td>
                <td class="num"><span t-esc="o._clearance_money(o.amount_total)"/> <span t-field="cur.name"/></td>
              </tr>
              <tr t-if="file and adv[0] is not None">
                <td>AVANCE HAD/DAU</td>
                <td class="num"><span t-esc="o._clearance_money(adv[0])"/> <span t-field="cur.name"/></td>
              </tr>
              <tr t-if="file and adv[1] is not None">
                <td>AVANCE TVA/HAD DAU</td>
                <td class="num"><span t-esc="o._clearance_money(adv[1])"/> <span t-field="cur.name"/></td>
              </tr>
              <tr t-if="file and adv[2] is not None">
                <td>AUTRES AVANCES</td>
                <td class="num"><span t-esc="o._clearance_money(adv[2])"/> <span t-field="cur.name"/></td>
              </tr>
              <tr t-if="file">
                <td>RESTE</td>
                <td class="num"><span t-esc="o._clearance_money(due)"/> <span t-field="cur.name"/></td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <p style="font-style:italic; margin-bottom:2px;">
        Arrêté la présente facture au montant de :
      </p>
      <p style="margin-bottom:14px;">
        <span t-esc="o._clearance_amount_in_words(due if file else o.amount_total)"/>
      </p>

      <!-- the company's own bank accounts, in the configured order -->
      <t t-set="banks" t-value="o._clearance_invoice_banks()"/>
      <!-- The box no longer disappears wholesale when no bank account is
           configured: the payment conditions belong on the invoice either
           way, and a silently absent block is how the owner ended up with
           an invoice missing its bank details entirely. -->
      <div class="bankbox" style="margin-top:14px;">
        <table class="bank">
          <tr t-if="banks">
            <td style="width:20%;">BANK :</td>
            <td t-foreach="banks" t-as="bank">
              <span t-field="bank.bank_id.name"/>
            </td>
          </tr>
          <tr t-if="banks">
            <td>ACCOUNT NAME :</td>
            <td t-foreach="banks" t-as="bank">
              <span t-esc="bank.acc_holder_name or bank.partner_id.name"/>
            </td>
          </tr>
          <tr t-if="banks">
            <td>ACCOUNT N° :</td>
            <td t-foreach="banks" t-as="bank">
              <span t-field="bank.acc_number"/>
            </td>
          </tr>
          <tr>
            <td>PAYMENT CONDITIONS :</td>
            <td>
              <span t-if="o.invoice_payment_term_id"
                    t-field="o.invoice_payment_term_id.name"/>
              <span t-else="" t-esc="company.clearance_invoice_payment_terms or 'As per agreement with customer'"/>
            </td>
            <td>
              Max period for complaints regarding invoices:
              <span t-esc="company.clearance_invoice_complaint_days or 15"/> days
            </td>
          </tr>
        </table>
      </div>

      <div class="foot">
        <span t-field="company.name"/>
        <t t-if="company.street"> - <span t-field="company.street"/></t>
        <t t-if="company.street2"> - <span t-field="company.street2"/></t>
        <t t-if="company.zip"> - <span t-field="company.zip"/></t>
        <t t-if="company.city"> <span t-field="company.city"/></t>
        <t t-if="company.phone"> - TEL : <span t-field="company.phone"/></t>
        <t t-if="company.email"> - Email : <span t-field="company.email"/></t>
        <t t-if="company.website"> - Site : <span t-field="company.website"/></t>
        <t t-if="company.vat"> - NIU : <span t-field="company.vat"/></t>
        <t t-if="company.company_registry"> - RC : <span t-field="company.company_registry"/></t>
      </div>

    </div>
  </template>

  <!--
    Odoo 19 does not DISPATCH on _get_name_invoice_report(); it GUARDS on
    it. account.report_invoice renders account.report_invoice_document
    only when the name matches, so an override that returns another name
    makes Send & Print produce a BLANK page unless the module adds its own
    branch here. This is that branch.
  -->
  <template id="report_invoice_clearance_branch"
            inherit_id="account.report_invoice">
    <xpath expr="//t[@t-call='account.report_invoice_document']"
           position="after">
      <t t-if="o._get_name_invoice_report() == 'elite_clearance.report_clearance_invoice_document'"
         t-call="elite_clearance.report_clearance_invoice_document"/>
    </xpath>
  </template>

  <template id="report_clearance_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="elite_clearance.report_clearance_invoice_document"/>
      </t>
    </t>
  </template>

</odoo>
