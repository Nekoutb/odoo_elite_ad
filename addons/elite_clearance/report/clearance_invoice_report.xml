<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- The sample sits tighter on the page than Odoo's default A4, which
       leaves 7mm all round and reserves space for a header/footer this
       template draws itself. -->
  <record id="paperformat_clearance_invoice" model="report.paperformat">
    <field name="name">Clearance Invoice A4</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">8</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">8</field>
    <field name="margin_right">8</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">90</field>
  </record>

  <record id="action_report_clearance_invoice" model="ir.actions.report">
    <field name="name">Clearance Invoice</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">elite_clearance.report_clearance_invoice</field>
    <field name="report_file">elite_clearance.report_clearance_invoice</field>
    <field name="print_report_name">'Facture - %s' % (object.name or '').replace('/', '')</field>
    <field name="paperformat_id" ref="paperformat_clearance_invoice"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>

</odoo>
