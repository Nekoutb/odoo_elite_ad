<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_logistics_expense" model="ir.sequence">
            <field name="name">Clearance Expense</field>
            <field name="code">logistics.expense</field>
            <field name="prefix">EXP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="expense_cat_duty" model="logistics.expense.category">
            <field name="name">Customs Duty &amp; Taxes</field><field name="code">DUTY</field><field name="sequence">10</field>
        </record>
        <record id="expense_cat_port" model="logistics.expense.category">
            <field name="name">Terminal / Port Charges</field><field name="code">PORT</field><field name="sequence">20</field>
        </record>
        <record id="expense_cat_line" model="logistics.expense.category">
            <field name="name">Shipping Line Fees</field><field name="code">LINE</field><field name="sequence">30</field>
        </record>
        <record id="expense_cat_transport" model="logistics.expense.category">
            <field name="name">Transport</field><field name="code">TRSP</field><field name="sequence">40</field>
        </record>
        <record id="expense_cat_handling" model="logistics.expense.category">
            <field name="name">Handling</field><field name="code">HDL</field><field name="sequence">50</field>
        </record>
        <record id="expense_cat_insurance" model="logistics.expense.category">
            <field name="name">Insurance</field><field name="code">INS</field><field name="sequence">60</field>
        </record>
        <record id="expense_cat_other" model="logistics.expense.category">
            <field name="name">Other</field><field name="code">OTH</field><field name="sequence">90</field>
        </record>
    </data>
</odoo>
