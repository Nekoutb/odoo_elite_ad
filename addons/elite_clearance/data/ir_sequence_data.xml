<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Clearance file references are NOT taken from here: they are
             structured per service type and per year (2026IM0009), so
             logistics.file._next_reference() creates one ir.sequence per
             (kind, service type, company) on first use. Only the expense
             sequence is a single global counter. -->

        <record id="seq_logistics_expense" model="ir.sequence">
            <field name="name">Clearance Expense</field>
            <field name="code">logistics.expense</field>
            <field name="prefix">EXP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
