<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Clearance file references are NOT taken from here: they are
             structured per service type and per year (2026IM0009), so
             logistics.file._next_reference() creates one ir.sequence per
             (kind, service type, company) on first use. Only the expense
             sequence is a single global counter. -->

        <!-- FA, the year, the month, then the running number of the
             year: FA26051022 (owner, 20/10/2026). The number continues
             through the year whatever the month; Settings > File
             Numbering points it after the last legacy reference. An
             upgraded database is brought to this shape by
             hooks.configure_expense_sequence. -->
        <record id="seq_logistics_expense" model="ir.sequence">
            <field name="name">Clearance Expense</field>
            <field name="code">logistics.expense</field>
            <field name="prefix">FA%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
