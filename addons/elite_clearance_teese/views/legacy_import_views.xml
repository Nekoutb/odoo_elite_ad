<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="legacy_import_view_form" model="ir.ui.view">
        <field name="name">logistics.legacy.import.form</field>
        <field name="model">logistics.legacy.import</field>
        <field name="arch" type="xml">
            <form string="Teese Legacy Import">
                <header>
                    <button name="action_import" type="object" string="Import"
                            class="oe_highlight" invisible="state == 'done'"
                            confirm="This creates partners, files, expenses and invoices from the export. It is idempotent: rows already imported are skipped. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Upload the Teese warehouse export (the zip with the six <code>wh_*.csv</code> tables).
                        Set the Clearance accounts and journals under Settings first so invoice lines land on the right accounts.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="zip_file" filename="zip_filename" readonly="state != 'draft'"/>
                            <field name="zip_filename" invisible="1"/>
                            <field name="post_invoices" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_done"/>
                        </group>
                    </group>
                    <group string="Created by this run" invisible="state == 'draft'">
                        <group>
                            <field name="count_partners"/>
                            <field name="count_suppliers"/>
                            <field name="count_employees"/>
                            <field name="count_ports"/>
                            <field name="count_products"/>
                        </group>
                        <group>
                            <field name="count_files"/>
                            <field name="count_expenses"/>
                            <field name="count_invoices"/>
                            <field name="count_lines"/>
                        </group>
                    </group>
                    <separator string="Log" invisible="not log"/>
                    <field name="log" readonly="1" invisible="not log"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="legacy_import_view_list" model="ir.ui.view">
        <field name="name">logistics.legacy.import.list</field>
        <field name="model">logistics.legacy.import</field>
        <field name="arch" type="xml">
            <list string="Legacy Imports">
                <field name="name"/>
                <field name="date_done"/>
                <field name="count_files"/>
                <field name="count_expenses"/>
                <field name="count_invoices"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_legacy_import" model="ir.actions.act_window">
        <field name="name">Teese Legacy Import</field>
        <field name="res_model">logistics.legacy.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Import the Teese export</p>
            <p>Upload the warehouse zip and press Import. Re-running skips what is already there.</p>
        </field>
    </record>

    <menuitem id="menu_legacy_import" name="Teese Legacy Import"
              parent="elite_clearance.menu_clearance_config"
              action="action_legacy_import" sequence="95"
              groups="base.group_system"/>

</odoo>
