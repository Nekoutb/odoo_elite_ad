[Unit]
Description=Elimelec Odoo overview actions (rebuild, deploy, promote, backup)
After=network.target docker.service
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/elimelec/bin/actions-server.py
Restart=always
RestartSec=3
User=root
WorkingDirectory=/opt/elimelec
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
