# /opt/elimelec/backups/backup.env  (mode 600, root) - no secrets live here;
# the Wasabi keys are in root's rclone configuration, keyed by the owner.

# which environment is backed up: staging until the cutover, prod after
BACKUP_ENV=prod

# the rclone remote and bucket for the off-site copy; empty = local only
RCLONE_REMOTE=wasabi:elimelec-odoo-backups

# optional: a healthchecks.io ping address per job; silence raises an alarm
HEALTHCHECK_URL=
HEALTHCHECK_RESTORE_URL=
